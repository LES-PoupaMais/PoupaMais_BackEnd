# Copie para .env. Os valores abaixo são os padrões de desenvolvimento (application.yml).

# Banco
DB_URL=jdbc:postgresql://localhost:5432/poupamais
DB_USER=poupamais
DB_PASSWORD=poupamais

# JWT (em produção use um segredo longo e aleatório: openssl rand -base64 64)
JWT_SECRET=troque-este-segredo-de-desenvolvimento-por-um-valor-longo-e-aleatorio
JWT_EXPIRACAO_MIN=480

# E-mail (Mailpit em desenvolvimento)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=PoupaMais <nao-responda@poupamais.local>

# Front (link de redefinição de senha) e CORS (Swagger/dev)
FRONT_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Liga os testes de integração (docker compose up -d db-test)
# POUPAMAIS_TEST_DB_URL=jdbc:postgresql://localhost:5433/poupamais_test
