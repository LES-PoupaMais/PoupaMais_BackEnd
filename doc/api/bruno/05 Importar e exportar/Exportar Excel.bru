meta {
  name: Exportar Excel
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/lancamentos/exportar?formato=xlsx
  body: none
  auth: inherit
}

params:query {
  formato: xlsx
  ~descricao: 
  ~mes: {{mes}}
  ~ano: {{ano}}
  ~tipo: DESPESA
  ~status: ATIVO
  ~categoriaId: {{categoriaId}}
}

tests {
  test("Status esperado (200)", function () {
    expect([200]).to.include(res.status);
  });
}
