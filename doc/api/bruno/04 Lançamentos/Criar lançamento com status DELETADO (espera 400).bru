meta {
  name: Criar lançamento com status DELETADO (espera 400)
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/lancamentos
  body: json
  auth: inherit
}

body:json {
  {
    "descricao": "Supermercado",
    "tipo": "DESPESA",
    "data": "{{data}}",
    "valor": 680.00,
    "status": "DELETADO",
    "categoriaIds": [{{categoriaId}}]
  }
}

tests {
  test("Status esperado (400)", function () {
    expect([400]).to.include(res.status);
  });
}

docs {
  `DELETADO` não vai no corpo (a lixeira é pelo DELETE): **400** com erro no campo `status`.
}
