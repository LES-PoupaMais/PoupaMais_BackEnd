meta {
  name: Listar lançamentos
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/lancamentos?pagina=0&tamanho=12
  body: none
  auth: inherit
}

params:query {
  ~descricao: 
  ~mes: {{mes}}
  ~ano: {{ano}}
  ~tipo: DESPESA
  ~status: ATIVO
  ~categoriaId: {{categoriaId}}
  pagina: 0
  tamanho: 12
}

tests {
  test("Status esperado (200)", function () {
    expect([200]).to.include(res.status);
  });
}

docs {
  Filtros opcionais (ative na aba Params). Sem `status` = ATIVO + INATIVO; `status=DELETADO` = lixeira. Paginado: `pagina` começa em 0 (padrão 0) e `tamanho` vai de 1 a 100 (padrão 12); fora disso, **400**. Resposta: `{itens, pagina, tamanho, total, totalPaginas}`. A exportação não pagina.
}
