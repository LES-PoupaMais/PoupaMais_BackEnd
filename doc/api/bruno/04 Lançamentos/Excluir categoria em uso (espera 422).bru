meta {
  name: Excluir categoria em uso (espera 422)
  type: http
  seq: 5
}

delete {
  url: {{baseUrl}}/api/categorias/{{categoriaId}}
  body: none
  auth: inherit
}

tests {
  test("Status esperado (422)", function () {
    expect([422]).to.include(res.status);
  });
  if (res.status >= 400) {
    test("Código de erro (CATEGORIA_VINCULADA)", function () {
      expect(res.body.codigo).to.eql("CATEGORIA_VINCULADA");
    });
  }
}

docs {
  **422** com `codigo` `CATEGORIA_VINCULADA`: categoria com lançamentos só pode ser inativada.
}
