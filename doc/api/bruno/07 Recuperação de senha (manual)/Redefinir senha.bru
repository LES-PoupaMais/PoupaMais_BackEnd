meta {
  name: Redefinir senha
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/redefinir-senha
  body: json
  auth: none
}

body:json {
  {
    "token": "{{tokenRedefinicao}}",
    "novaSenha": "{{senha}}"
  }
}

tests {
  test("Status esperado (204, 422)", function () {
    expect([204, 422]).to.include(res.status);
  });
}

docs {
  Copie o `token` do link recebido no Mailpit para a variável `tokenRedefinicao`. Sem token válido a resposta é **422** (é o que acontece ao rodar a coleção inteira).
}
