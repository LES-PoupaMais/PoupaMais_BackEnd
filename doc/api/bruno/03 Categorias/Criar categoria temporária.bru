meta {
  name: Criar categoria temporária
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/categorias
  body: json
  auth: inherit
}

body:json {
  {
    "descricao": "Temporária {{$timestamp}}"
  }
}

script:post-response {
  if (res.status < 300) {
    bru.setVar("categoriaTempId", res.body.id);
  }
}

tests {
  test("Status esperado (201)", function () {
    expect([201]).to.include(res.status);
  });
}
