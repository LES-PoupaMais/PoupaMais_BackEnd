meta {
  name: Listar categorias
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/categorias
  body: none
  auth: inherit
}

params:query {
  ~ativa: true
  ~mes: {{mes}}
  ~ano: {{ano}}
}

tests {
  test("Status esperado (200)", function () {
    expect([200]).to.include(res.status);
  });
}

docs {
  Sem `ativa` lista todas; `ativa=true` ou `false` filtra. Cada categoria traz `quantidadeLancamentos`: lançamentos ATIVO e INATIVO cuja `data` cai em `mes`/`ano` (sem eles, o mês atual; DELETADO não conta). `mes`/`ano` não filtram as categorias. Mês fora de 1–12 ou ano fora de 2000–2100 → **400**.
}
