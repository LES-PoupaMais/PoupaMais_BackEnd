meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "senha": "{{senha}}"
  }
}

script:post-response {
  if (res.status < 300) {
    bru.setVar("token", res.body.token);
  }
}

tests {
  test("Status esperado (200)", function () {
    expect([200]).to.include(res.status);
  });
}

docs {
  Guarda o JWT na variável `token`; as demais requisições usam `Authorization: Bearer {{token}}`.
}
