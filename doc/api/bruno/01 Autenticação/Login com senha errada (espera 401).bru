meta {
  name: Login com senha errada (espera 401)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "senha": "senha-errada"
  }
}

tests {
  test("Status esperado (401)", function () {
    expect([401]).to.include(res.status);
  });
}
