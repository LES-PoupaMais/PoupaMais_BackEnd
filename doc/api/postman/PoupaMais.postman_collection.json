              "raw": "{{baseUrl}}/api/lancamentos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "lancamentos"
              ],
              "query": [
                {
                  "key": "descricao",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "mes",
                  "value": "{{mes}}",
                  "disabled": true
                },
                {
                  "key": "ano",
                  "value": "{{ano}}",
                  "disabled": true
                },
                {
                  "key": "tipo",
                  "value": "DESPESA",
                  "disabled": true
                },
                {
                  "key": "status",
                  "value": "ATIVO",
                  "disabled": true
                },
                {
                  "key": "categoriaId",
                  "value": "{{categoriaId}}",
                  "disabled": true
                }
              ]
            },
            "description": "Filtros opcionais (ative na aba Params). Sem `status` = ATIVO + INATIVO; `status=DELETADO` = lixeira."
