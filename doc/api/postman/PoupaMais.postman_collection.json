              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "usuarios",
                "me",
                "senha"
              ]
            },
            "description": "Devolve um token novo (guardado em `token`) e inverte as variáveis `senha` e `novaSenha`, para a coleção continuar funcionando. **422** se a senha atual estiver errada ou a nova for igual.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"senhaAtual\": \"{{senha}}\",\n  \"novaSenha\": \"{{novaSenha}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status esperado (200)\", function () {",
                  "  pm.expect([200]).to.include(pm.response.code);",
                  "});",
                  "if (pm.response.code < 300) {",
                  "  pm.collectionVariables.set(\"token\", pm.response.json().token);",
                  "  const antiga = pm.collectionVariables.get(\"senha\");",
                  "  pm.collectionVariables.set(\"senha\", pm.collectionVariables.get(\"novaSenha\"));",
                  "  pm.collectionVariables.set(\"novaSenha\", antiga);",
                  "}"
                ]
              }
            }
          ]
        },
